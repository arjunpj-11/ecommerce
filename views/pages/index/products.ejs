<%
  const safeCategories = Array.isArray(categoriesWithSubs) ? categoriesWithSubs : [];
  const safeCards = Array.isArray(cards) ? cards : [];
  const pageTitle = typeof title === 'string' && title.trim() ? title : 'Products';
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> — ARNI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/index/products.css">
</head>
<body>
    <header class="navbar" id="navbar">
        <div class="nav-inner">
            <a href="/" class="logo" aria-label="ARNI Home">ARNI</a>

            <nav class="nav-links" id="navLinks" aria-label="Primary navigation">
                <a href="/" class="nav-link">Home</a>
                <a href="/shop" class="nav-link">Shop</a>
                <% if (safeCategories.length > 0) { %>
                    <a href="/shop" class="nav-link has-dropdown" data-category="true">
                        Categories
                        <i class="fas fa-chevron-down dropdown-arrow"></i>
                    </a>
                <% } %>
            </nav>

            <div class="nav-actions">
                <button class="icon-btn search-toggle" type="button" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
                <a href="/users/cart" class="icon-btn cart-btn" aria-label="Cart">
                    <i class="fas fa-shopping-bag"></i>
                    <span class="cart-dot"></span>
                </a>
                <% if (authentication) { %>
                    <a href="/users/pI" class="icon-btn" aria-label="Profile">
                        <i class="fas fa-user"></i>
                    </a>
                <% } else { %>
                    <a href="/auth/login" class="btn-pill">Login</a>
                <% } %>
                <button class="hamburger" id="hamburger" type="button" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="search-overlay" id="searchOverlay">
            <form class="search-form" action="/search" method="GET">
                <i class="fas fa-search search-form-icon" aria-hidden="true"></i>
                <input type="text" name="search" placeholder="Search products, styles, categories…" class="search-input" autocomplete="off">
                <button type="submit" class="search-submit">Search</button>
                <button type="button" class="search-close" id="searchClose" aria-label="Close search">
                    <i class="fas fa-times"></i>
                </button>
            </form>
        </div>
    </header>

    <div class="mobile-overlay" id="mobileOverlay"></div>
    <aside class="mobile-drawer" id="mobileDrawer" aria-label="Mobile navigation">
        <button class="drawer-close" id="drawerClose" type="button" aria-label="Close menu">
            <i class="fas fa-times"></i>
        </button>
        <a href="/" class="drawer-logo">ARNI</a>
        <nav class="drawer-nav">
            <a href="/">Home</a>
            <a href="/shop">Shop</a>
            <% safeCategories.forEach(function(category) { %>
                <a href="/subcategories?main=<%= category._id %>">
                    <%= category.mainCategoryName %>
                </a>
            <% }); %>
            <a href="/users/cart">Cart</a>
            <% if (authentication) { %>
                <a href="/users/pI">My Profile</a>
            <% } else { %>
                <a href="/auth/login">Login</a>
            <% } %>
        </nav>
    </aside>

    <main class="page-shell">
        <section class="products-hero">
            <div class="container">
                <p class="section-eyebrow">Collection</p>
                <h1><%= pageTitle.toUpperCase() %></h1>
                <p>Explore curated ARNI styles with clean fits, modern details, and everyday comfort.</p>
            </div>
        </section>

        <section class="products-section">
            <div class="container">
                <div class="section-header between">
                    <div>
                        <p class="section-eyebrow">Results</p>
                        <h2 class="section-title">Product Collection</h2>
                    </div>
                    <span class="result-count"><%= safeCards.length %> item<%= safeCards.length === 1 ? '' : 's' %></span>
                </div>

                <% if (safeCards.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-icon"><i class="fas fa-search"></i></div>
                        <h3>No Products Found</h3>
                        <p>This collection is currently under maintenance. Please check back soon.</p>
                        <a href="/shop" class="btn-pill large">Back to Shop</a>
                    </div>
                <% } else { %>
                    <div class="product-grid">
                        <% safeCards.forEach(function(card) { %>
                            <%
                                const product = card.productDetails || {};
                                const price = Number(product.price || 0);
                                const discountPrice = Number(product.discountPrice || price || 0);
                                const hasDiscount = price > discountPrice;
                                const discount = hasDiscount ? Math.round((1 - discountPrice / price) * 100) : 0;
                                const imageSrc = Array.isArray(card.images) ? card.images[0] : card.images;
                            %>
                            <a href="/overview/<%= card._id %>" class="product-card-link">
                                <article class="product-card">
                                    <div class="product-image-container">
                                        <img src="<%= imageSrc %>"
                                             alt="<%= product.name || 'ARNI product' %>"
                                             class="product-image"
                                             loading="lazy">
                                        <div class="product-overlay">
                                            <span>Quick View</span>
                                        </div>
                                        <% if (hasDiscount) { %>
                                            <span class="product-badge"><%= discount %>% OFF</span>
                                        <% } %>
                                    </div>
                                    <div class="product-info">
                                        <h3 class="product-name"><%= product.name || 'ARNI Product' %></h3>
                                        <div class="price-layout">
                                            <div class="price-row">
                                                <span class="discount-price">₹<%= discountPrice.toFixed(2) %></span>
                                                <% if (hasDiscount) { %>
                                                    <span class="original-price">₹<%= price.toFixed(2) %></span>
                                                <% } %>
                                            </div>
                                            <% if (hasDiscount) { %>
                                                <span class="discount-percentage"><%= discount %>% off</span>
                                            <% } %>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <span class="footer-logo">ARNI</span>
                    <p>Fashion for everyone. Curated with intention.</p>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/shop">Shop</a>
                    <a href="/users/cart">Cart</a>
                </div>
                <div class="footer-col">
                    <h4>Account</h4>
                    <% if (authentication) { %>
                        <a href="/users/pI">Profile</a>
                    <% } else { %>
                        <a href="/auth/login">Login</a>
                    <% } %>
                    <a href="/users/cart">Cart</a>
                </div>
                <div class="footer-col">
                    <h4>Connect</h4>
                    <a href="#">Instagram</a>
                    <a href="#">Facebook</a>
                    <a href="#">Twitter</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© 2025 ARNI. All rights reserved.</span>
                <span>info@arni.com</span>
            </div>
        </div>
    </footer>

    <script id="arni-categories-data" type="application/json">
        <%- JSON.stringify(safeCategories || []) %>
    </script>
    <script src="/javascripts/index/products.js"></script>
</body>
</html>
