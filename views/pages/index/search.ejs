<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Product Search — ARNI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/index/search.css">
</head>
<body>
    <% const safeCategories = Array.isArray(categoriesWithSubs) ? categoriesWithSubs : []; %>
    <% const initialSearch = typeof search !== 'undefined' ? search : ''; %>

    <!-- ========== NAVBAR ========== -->
    <header class="navbar" id="navbar">
        <div class="nav-inner">
            <a href="/" class="logo">ARNI</a>

            <nav class="nav-links" id="navLinks">
                <a href="/" class="nav-link">Home</a>
                <a href="/shop" class="nav-link">Shop</a>
                <% if (safeCategories.length > 0) { %>
                    <a href="/subcategories?main=<%= safeCategories[0]._id %>"
                       class="nav-link has-dropdown"
                       data-category="true">
                        Categories
                        <i class="fas fa-chevron-down dropdown-arrow"></i>
                    </a>
                <% } %>
            </nav>

            <div class="nav-actions">
                <button class="icon-btn search-toggle" type="button" aria-label="Open search">
                    <i class="fas fa-search"></i>
                </button>
                <a href="/users/cart" class="icon-btn cart-btn" aria-label="Cart">
                    <i class="fas fa-shopping-bag"></i>
                    <span class="cart-dot"></span>
                </a>
                <% if (authentication) { %>
                    <a href="/users/pI" class="icon-btn" aria-label="Profile">
                        <i class="fas fa-user"></i>
                    </a>
                <% } else { %>
                    <a href="/auth/login" class="btn-pill">Login</a>
                <% } %>
                <button class="hamburger" id="hamburger" type="button" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="search-overlay" id="searchOverlay">
            <form class="search-form" action="/search" method="GET">
                <input type="text" name="search" placeholder="Search products..." class="search-input" value="<%= initialSearch %>">
                <button type="submit" class="search-submit" aria-label="Search"><i class="fas fa-search"></i></button>
                <button type="button" class="search-close" id="searchClose" aria-label="Close search"><i class="fas fa-times"></i></button>
            </form>
        </div>
    </header>

    <!-- Mobile Drawer -->
    <div class="mobile-overlay" id="mobileOverlay"></div>
    <aside class="mobile-drawer" id="mobileDrawer">
        <button class="drawer-close" id="drawerClose" type="button" aria-label="Close menu"><i class="fas fa-times"></i></button>
        <div class="drawer-logo">ARNI</div>
        <nav class="drawer-nav">
            <a href="/">Home</a>
            <a href="/shop">Shop</a>
            <a href="/search">Search</a>
            <a href="/users/cart">Cart</a>
            <% safeCategories.forEach(function(category) { %>
                <a href="/subcategories?main=<%= category._id %>">
                    <%= category.mainCategoryName %>
                </a>
            <% }); %>
        </nav>
        <div class="drawer-footer">
            <% if (authentication) { %>
                <a href="/users/pI" class="btn-pill">My Profile</a>
            <% } else { %>
                <a href="/auth/login" class="btn-pill">Login</a>
            <% } %>
        </div>
    </aside>

    <!-- Mobile Filter Overlay -->
    <div class="filter-overlay" id="filterOverlay"></div>

    <!-- ========== PAGE HERO ========== -->
    <section class="search-hero">
        <div class="container">
            <p class="section-eyebrow">Find your style</p>
            <h1 class="page-title">Search Products</h1>
            <p class="page-subtitle">Explore ARNI collections with smart filters, categories, price range, and instant suggestions.</p>
        </div>
    </section>

    <!-- ========== MAIN CONTENT ========== -->
    <main class="main-content">
        <button class="filter-toggle" id="filterToggle" type="button">
            <i class="fas fa-sliders-h"></i>
            Filters
        </button>

        <aside class="filters" id="filtersPanel">
            <div class="filter-panel-header">
                <h2>Filters</h2>
                <button class="filter-close" id="filterClose" type="button" aria-label="Close filters">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <div class="filter-section">
                <h3 class="filter-title">Sort By</h3>
                <select class="sort-dropdown">
                    <option value="popularity">Popularity</option>
                    <option value="price-low-high">Price: Low to High</option>
                    <option value="price-high-low">Price: High to Low</option>
                    <option value="rating">Average Rating</option>
                    <option value="az">A - Z</option>
                    <option value="za">Z - A</option>
                </select>
            </div>

            <div class="filter-section">
                <h3 class="filter-title">Categories</h3>
                <div class="filter-group">
                    <% if (safeCategories.length === 0) { %>
                        <p class="filter-empty">No categories available.</p>
                    <% } %>
                    <% safeCategories.forEach(function(category) { %>
                        <label class="filter-checkbox">
                            <input type="checkbox" name="category" value="<%= category._id %>">
                            <span>
                                <%= category.mainCategoryName.split(' ')
                                    .map((word, index) => index === 0 ? word.charAt(0).toUpperCase() + word.slice(1).toLowerCase() : word.toLowerCase())
                                    .join(' ') %>
                            </span>
                        </label>
                    <% }); %>
                </div>
            </div>

            <div class="filter-section">
                <h3 class="filter-title">Price Range</h3>
                <div class="price-range">
                    <input type="number" class="price-input" placeholder="Min" id="minPrice">
                    <span>to</span>
                    <input type="number" class="price-input" placeholder="Max" id="maxPrice">
                </div>
                <button class="apply-btn" type="button">Apply Price</button>
            </div>

            <div class="filter-section">
                <h3 class="filter-title">Size</h3>
                <div class="filter-group size-filter-grid">
                    <% ['XS', 'S', 'M', 'L', 'XL', 'XXL'].forEach(function(size) { %>
                        <label class="size-filter">
                            <input type="checkbox" name="size" value="<%= size %>">
                            <span><%= size %></span>
                        </label>
                    <% }); %>
                </div>
            </div>

            <button class="clear-filters" id="clearFilters" type="button">Clear All</button>
        </aside>

        <section class="products-container">
            <div class="search-section">
                <div class="search-container">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text"
                           class="search-input"
                           placeholder="Search products..."
                           id="searchInput"
                           value="<%= initialSearch %>"
                           autocomplete="off">
                    <button class="inline-search-btn" id="inlineSearchBtn" type="button">Search</button>
                    <div class="suggestions" id="suggestions"></div>
                </div>
            </div>

            <div class="results-toolbar">
                <div>
                    <p class="section-eyebrow">Results</p>
                    <h2 class="results-title">Product Collection</h2>
                </div>
                <span class="results-count" id="resultsCount">Loading...</span>
            </div>

            <div class="product-grid" id="productGrid"></div>
            <div class="loading-spinner" id="loadingSpinner"></div>
            <div class="pagination" id="pagination"></div>
        </section>
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <span class="footer-logo">ARNI</span>
                    <p>Fashion for everyone. Curated with intention.</p>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/shop">Shop</a>
                    <a href="/users/cart">Cart</a>
                </div>
                <div class="footer-col">
                    <h4>Help</h4>
                    <a href="/contact">Contact Us</a>
                    <a href="/returns">Returns</a>
                    <a href="/size-guide">Sizing Guide</a>
                </div>
                <div class="footer-col">
                    <h4>Connect</h4>
                    <a href="#">Instagram</a>
                    <a href="#">Facebook</a>
                    <a href="#">Twitter</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© 2025 ARNI. All rights reserved.</span>
                <span>info@arni.com</span>
            </div>
        </div>
    </footer>

    <script id="arni-categories-data" type="application/json">
        <%- JSON.stringify(safeCategories || []) %>
    </script>
    <script src="/javascripts/index/search.js"></script>
</body>
</html>
