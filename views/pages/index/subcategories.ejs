<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title ? `${title} - ARNI` : 'Subcategories - ARNI' %></title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/index/subcategories.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <% const safeCategories = Array.isArray(categoriesWithSubs) ? categoriesWithSubs : []; %>
    <% const safeSubcategories = Array.isArray(subcategories) ? subcategories : []; %>

    <!-- ========== NAVBAR ========== -->
    <header class="navbar" id="navbar">
        <div class="nav-inner">
            <a href="/" class="logo" aria-label="ARNI home">ARNI</a>

            <nav class="nav-links" id="navLinks" aria-label="Primary navigation">
                <a href="/" class="nav-link">Home</a>
                <a href="/shop" class="nav-link">Shop</a>
                <% if (safeCategories.length > 0) { %>
                    <a href="#" class="nav-link has-dropdown" data-category="true">
                        Categories
                        <i class="fas fa-chevron-down dropdown-arrow"></i>
                    </a>
                <% } %>
            </nav>

            <div class="nav-actions">
                <button class="icon-btn search-toggle" type="button" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
                <a href="/users/cart" class="icon-btn cart-btn" aria-label="Cart">
                    <i class="fas fa-shopping-bag"></i>
                    <span class="cart-dot"></span>
                </a>
                <% if (authentication) { %>
                    <a href="/users/pI" class="icon-btn" aria-label="Profile">
                        <i class="fas fa-user"></i>
                    </a>
                <% } else { %>
                    <a href="/auth/login" class="btn-pill">Login</a>
                <% } %>
                <button class="hamburger" id="hamburger" type="button" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="search-overlay" id="searchOverlay">
            <form class="search-form" action="/search" method="GET">
                <input type="text" name="search" placeholder="Search products, styles, categories…" class="search-input" autocomplete="off">
                <button type="submit" class="search-submit" aria-label="Submit search">
                    <i class="fas fa-search"></i>
                </button>
                <button type="button" class="search-close" id="searchClose" aria-label="Close search">
                    <i class="fas fa-times"></i>
                </button>
            </form>
        </div>
    </header>

    <!-- Mobile Drawer -->
    <div class="mobile-overlay" id="mobileOverlay"></div>
    <aside class="mobile-drawer" id="mobileDrawer" aria-label="Mobile menu">
        <button class="drawer-close" id="drawerClose" type="button" aria-label="Close menu">
            <i class="fas fa-times"></i>
        </button>
        <a href="/" class="drawer-logo">ARNI</a>
        <nav class="drawer-nav">
            <a href="/">Home</a>
            <a href="/shop">Shop</a>
            <% safeCategories.forEach(function(category) { %>
                <a href="/subcategories?main=<%= category._id %>">
                    <%= category.mainCategoryName %>
                </a>
            <% }); %>
            <a href="/users/cart">Cart</a>
            <% if (authentication) { %>
                <a href="/users/pI">Profile</a>
            <% } else { %>
                <a href="/auth/login">Login</a>
            <% } %>
        </nav>
    </aside>

    <!-- ========== PAGE HERO ========== -->
    <main>
        <section class="page-hero">
            <div class="hero-glow hero-glow-one"></div>
            <div class="hero-glow hero-glow-two"></div>
            <div class="container hero-container">
                <p class="section-eyebrow">Explore Collection</p>
                <h1 class="page-title"><%= title ? title : 'Categories' %></h1>
                <p class="page-subtitle">
                    Discover curated styles, offers, and collections made for your wardrobe.
                </p>
                <div class="breadcrumb">
                    <a href="/">Home</a>
                    <i class="fas fa-chevron-right"></i>
                    <span><%= title ? title : 'Subcategories' %></span>
                </div>
            </div>
        </section>

        <!-- ========== SUBCATEGORIES ========== -->
        <section class="section subcategories-section">
            <div class="container">
                <div class="section-header between">
                    <div>
                        <p class="section-eyebrow">Shop by type</p>
                        <h2 class="section-title"><%= title ? title.toUpperCase() : 'SUBCATEGORIES' %></h2>
                    </div>
                    <a href="/shop" class="view-all-btn">View Shop <i class="fas fa-arrow-right"></i></a>
                </div>

                <% if (safeSubcategories.length === 0) { %>
                    <div class="empty-state">
                        <div class="empty-icon"><i class="fas fa-search"></i></div>
                        <h3>No subcategories found</h3>
                        <p>This collection is under maintenance. Please check back soon.</p>
                        <a href="/shop" class="btn-pill large">Back to Shop</a>
                    </div>
                <% } else { %>
                    <div class="subcategories-grid">
                        <% safeSubcategories.forEach(function(subcategory, index) { %>
                            <a href="/products?sub=<%= subcategory._id %>" class="subcategory-card" data-index="<%= index %>">
                                <div class="subcategory-image-wrap">
                                    <img
                                        src="<%= subcategory.image %>"
                                        alt="<%= subcategory.subCategoryName %>"
                                        class="subcategory-image"
                                        loading="lazy"
                                    >
                                    <div class="subcategory-overlay"></div>
                                    <% if (subcategory.offerPercentage > 0) { %>
                                        <span class="offer-badge"><%= subcategory.offerPercentage %>% OFF</span>
                                    <% } %>
                                </div>
                                <div class="subcategory-info">
                                    <div>
                                        <p class="subcategory-label">Collection</p>
                                        <h3 class="subcategory-name"><%= subcategory.subCategoryName %></h3>
                                    </div>
                                    <span class="subcategory-arrow"><i class="fas fa-arrow-right"></i></span>
                                </div>
                            </a>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <span class="footer-logo">ARNI</span>
                    <p>Fashion for everyone. Curated with intention.</p>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/shop">Shop</a>
                    <a href="/users/cart">Cart</a>
                </div>
                <div class="footer-col">
                    <h4>Account</h4>
                    <% if (authentication) { %>
                        <a href="/users/pI">Profile</a>
                    <% } else { %>
                        <a href="/auth/login">Login</a>
                    <% } %>
                    <a href="/users/cart">Cart</a>
                </div>
                <div class="footer-col">
                    <h4>Connect</h4>
                    <a href="mailto:info@arni.com">Email ARNI</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© <%= new Date().getFullYear() %> ARNI. All rights reserved.</span>
                <span>info@arni.com</span>
            </div>
        </div>
    </footer>

    <script id="arni-categories-data" type="application/json"><%- JSON.stringify(safeCategories || []) %></script>
    <script src="/javascripts/index/subcategories.js"></script>
</body>
</html>
