<!DOCTYPE html>
<html lang="en">
<head>
    <% const safeCategories = Array.isArray(categoriesWithSubs) ? categoriesWithSubs : []; %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Shop — ARNI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/index/shop.css">
</head>
<body>
    <!-- ========== NAVBAR ========== -->
    <header class="navbar" id="navbar">
        <div class="nav-inner">
            <a href="/" class="logo">ARNI</a>

            <nav class="nav-links" id="navLinks">
                <a href="/" class="nav-link">Home</a>
                <a href="/shop" class="nav-link active">Shop</a>
                <% if (safeCategories.length > 0) { %>
                    <a href="/shop" class="nav-link has-dropdown" data-category="true">
                        Categories
                        <i class="fas fa-chevron-down dropdown-arrow"></i>
                    </a>
                <% } %>
            </nav>

            <div class="nav-actions">
                <button class="icon-btn search-toggle" type="button" aria-label="Search">
                    <i class="fas fa-search"></i>
                </button>
                <a href="/users/cart" class="icon-btn cart-btn" aria-label="Cart">
                    <i class="fas fa-shopping-bag"></i>
                    <span class="cart-dot"></span>
                </a>
                <% if (authentication) { %>
                    <a href="/users/pI" class="icon-btn profile-btn" aria-label="Profile">
                        <i class="fas fa-user"></i>
                    </a>
                <% } else { %>
                    <a href="/auth/login" class="btn-pill">Login</a>
                <% } %>
                <button class="hamburger" id="hamburger" type="button" aria-label="Menu">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="search-overlay" id="searchOverlay">
            <form class="search-form" action="/search" method="GET">
                <input type="text" name="search" placeholder="Search for styles, products, brands…" class="search-input">
                <button type="submit" class="search-submit" aria-label="Submit search">
                    <i class="fas fa-search"></i>
                </button>
                <button type="button" class="search-close" id="searchClose" aria-label="Close search">
                    <i class="fas fa-times"></i>
                </button>
            </form>
        </div>
    </header>

    <!-- ========== MOBILE DRAWER ========== -->
    <div class="mobile-overlay" id="mobileOverlay"></div>
    <aside class="mobile-drawer" id="mobileDrawer">
        <button class="drawer-close" id="drawerClose" type="button" aria-label="Close menu">
            <i class="fas fa-times"></i>
        </button>
        <a href="/" class="drawer-logo">ARNI</a>

        <nav class="drawer-nav">
            <a href="/">Home</a>
            <a href="/shop">Shop</a>
            <% safeCategories.forEach(function(category) { %>
                <a href="/subcategories?main=<%= category._id %>">
                    <%= category.mainCategoryName %>
                </a>
            <% }); %>
            <a href="/users/cart">Cart</a>
            <% if (authentication) { %>
                <a href="/users/pI">Profile</a>
            <% } else { %>
                <a href="/auth/login">Login</a>
            <% } %>
        </nav>
    </aside>

    <!-- ========== SHOP HERO ========== -->
    <section class="shop-hero">
        <div class="shop-hero-bg"></div>
        <div class="container shop-hero-inner">
            <p class="section-eyebrow">Explore ARNI</p>
            <h1 class="shop-title">Shop The Collection</h1>
            <p class="shop-subtitle">
                Discover fresh styles, best sellers, and everyday essentials curated for your wardrobe.
            </p>
        </div>
    </section>

    <!-- ========== MARQUEE STRIP ========== -->
    <div class="marquee-strip">
        <div class="marquee-track">
            <span>FREE SHIPPING OVER ₹999</span><span class="dot">·</span>
            <span>NEW ARRIVALS EVERY WEEK</span><span class="dot">·</span>
            <span>EXCLUSIVE MEMBER OFFERS</span><span class="dot">·</span>
            <span>HASSLE-FREE RETURNS</span><span class="dot">·</span>
            <span>FREE SHIPPING OVER ₹999</span><span class="dot">·</span>
            <span>NEW ARRIVALS EVERY WEEK</span><span class="dot">·</span>
            <span>EXCLUSIVE MEMBER OFFERS</span><span class="dot">·</span>
            <span>HASSLE-FREE RETURNS</span><span class="dot">·</span>
        </div>
    </div>

    <!-- ========== SHOP CONTENT ========== -->
    <main class="shop-section">
        <div class="container shop-layout">
            <button class="filter-toggle" id="filterToggle" type="button">
                <i class="fas fa-sliders-h"></i>
                Filters
            </button>

            <aside class="filters" id="filtersPanel">
                <div class="filters-header">
                    <div>
                        <p class="section-eyebrow">Refine</p>
                        <h2>Filters</h2>
                    </div>
                    <button class="filters-close" id="filtersClose" type="button" aria-label="Close filters">
                        <i class="fas fa-times"></i>
                    </button>
                </div>

                <div class="filter-section">
                    <h3 class="filter-title">Sort By</h3>
                    <select class="sort-dropdown" aria-label="Sort products">
                        <option value="popularity">Popularity</option>
                        <option value="price-low-high">Price: Low to High</option>
                        <option value="price-high-low">Price: High to Low</option>
                        <option value="rating">Average Rating</option>
                        <option value="az">A - Z</option>
                        <option value="za">Z - A</option>
                    </select>
                </div>

                <% if (safeCategories.length > 0) { %>
                    <div class="filter-section">
                        <h3 class="filter-title">Categories</h3>
                        <div class="filter-group">
                            <% safeCategories.forEach(function(category) { %>
                                <label class="filter-checkbox">
                                    <input type="checkbox" name="category" value="<%= category._id %>">
                                    <span>
                                        <%= category.mainCategoryName.split(' ')
                                            .map((word, index) => index === 0
                                                ? word.charAt(0).toUpperCase() + word.slice(1).toLowerCase()
                                                : word.toLowerCase())
                                            .join(' ') %>
                                    </span>
                                </label>
                            <% }); %>
                        </div>
                    </div>
                <% } %>

                <div class="filter-section">
                    <h3 class="filter-title">Price Range</h3>
                    <div class="price-range">
                        <input type="number" class="price-input" placeholder="Min" id="minPrice" min="0">
                        <span>to</span>
                        <input type="number" class="price-input" placeholder="Max" id="maxPrice" min="0">
                    </div>
                    <button class="apply-btn" type="button">Apply</button>
                </div>
            </aside>

            <section class="products-container">
                <div class="section-header between">
                    <div>
                        <p class="section-eyebrow">Products</p>
                        <h2 class="section-title">All Styles</h2>
                    </div>
                    <p class="product-count" id="productCount">Loading products…</p>
                </div>

                <div class="product-grid" id="productGrid"></div>
                <div class="loading-spinner" id="loadingSpinner" aria-label="Loading"></div>
                <div class="pagination" id="pagination"></div>
            </section>
        </div>
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <span class="footer-logo">ARNI</span>
                    <p>Fashion for everyone. Curated with intention.</p>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/shop">Shop</a>
                    <a href="/users/cart">Cart</a>
                </div>
                <div class="footer-col">
                    <h4>Help</h4>
                    <a href="/returns">Returns</a>
                    <a href="/size-guide">Sizing Guide</a>
                    <a href="/contact">Contact Us</a>
                </div>
                <div class="footer-col">
                    <h4>Connect</h4>
                    <a href="#">Instagram</a>
                    <a href="#">Facebook</a>
                    <a href="#">Twitter</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© 2025 ARNI. All rights reserved.</span>
                <span>info@arni.com</span>
            </div>
        </div>
    </footer>

    <script id="arni-categories-data" type="application/json">
        <%- JSON.stringify(safeCategories || []) %>
    </script>
    <script src="/javascripts/index/shop.js"></script>
</body>
</html>
