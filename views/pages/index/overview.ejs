<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - ARNI</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=DM+Sans:wght@300;400;500;600;700;800&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/index/overview.css">
    <link rel="stylesheet" href="/stylesheets/style.css">
</head>
<body>
    <!-- ========== NAVBAR ========== -->
    <header class="navbar" id="navbar">
        <div class="nav-inner">
            <a href="/" class="logo">ARNI</a>

            <nav class="nav-links" id="navLinks">
                <a href="/" class="nav-link">Home</a>
                <a href="/shop" class="nav-link active">Shop</a>
                <a href="/shop" class="nav-link has-dropdown" data-category="true">
                    Categories
                    <i class="fas fa-chevron-down dropdown-arrow"></i>
                </a>
            </nav>

            <div class="nav-actions">
                <button class="icon-btn search-toggle" aria-label="Search" type="button">
                    <i class="fas fa-search"></i>
                </button>
                <a href="/users/cart" class="icon-btn cart-btn" aria-label="Cart">
                    <i class="fas fa-shopping-bag"></i>
                    <span class="cart-dot"></span>
                </a>
                <% if (authentication) { %>
                    <a href="/users/pI" class="icon-btn" aria-label="Profile">
                        <i class="fas fa-user"></i>
                    </a>
                <% } else { %>
                    <a href="/auth/login" class="btn-pill">Login</a>
                <% } %>
                <button class="hamburger" id="hamburger" aria-label="Menu" type="button">
                    <span></span><span></span><span></span>
                </button>
            </div>
        </div>

        <div class="search-overlay" id="searchOverlay">
            <form class="search-form" action="/search" method="GET">
                <input type="text" name="search" placeholder="Search for styles, brands…" class="search-input">
                <button type="submit" class="search-submit" aria-label="Submit search"><i class="fas fa-search"></i></button>
                <button type="button" class="search-close" id="searchClose" aria-label="Close search"><i class="fas fa-times"></i></button>
            </form>
        </div>
    </header>

    <!-- Mobile Drawer -->
    <div class="mobile-overlay" id="mobileOverlay"></div>
    <aside class="mobile-drawer" id="mobileDrawer">
        <button class="drawer-close" id="drawerClose" aria-label="Close menu" type="button"><i class="fas fa-times"></i></button>
        <div class="drawer-logo">ARNI</div>
        <nav class="drawer-nav">
            <a href="/">Home</a>
            <a href="/shop">Shop</a>
            <% (categoriesWithSubs || []).forEach(function(category) { %>
                <a href="/subcategories?main=<%= category._id %>">
                    <%= category.mainCategoryName %>
                </a>
            <% }); %>
            <a href="/users/cart">Cart</a>
            <% if (authentication) { %>
                <a href="/users/pI">Profile</a>
            <% } else { %>
                <a href="/auth/login">Login</a>
            <% } %>
        </nav>
    </aside>

    <!-- ========== PRODUCT OVERVIEW ========== -->
    <main class="overview-page">
        <section class="product-hero-shell">
            <div class="container">
                <div class="breadcrumb">
                    <a href="/">Home</a>
                    <i class="fas fa-chevron-right"></i>
                    <a href="/shop">Shop</a>
                    <i class="fas fa-chevron-right"></i>
                    <span><%= product.name %></span>
                </div>

                <div class="product-layout">
                    <section class="product-gallery-card">
                        <div class="gallery-badge">Product Preview</div>

                        <div class="product-gallery">
                            <div class="thumbnail-column custom-scroll">
                                <% if (variant.images && variant.images.length) { %>
                                    <% variant.images.forEach((image, index) => { %>
                                        <button class="thumbnail-btn <%= index === 0 ? 'active' : '' %>" type="button" aria-label="View image <%= index + 1 %>">
                                            <img src="<%= image %>"
                                                 alt="Product thumbnail <%= index + 1 %>"
                                                 class="thumbnail"
                                                 data-full="<%= image %>">
                                        </button>
                                    <% }); %>
                                <% } %>
                            </div>

                            <div class="main-image-container">
                                <% if (variant.images && variant.images.length) { %>
                                    <img src="<%= variant.images[0] %>"
                                         alt="<%= product.name %> main image"
                                         class="main-image">
                                <% } else { %>
                                    <div class="image-placeholder">No Image</div>
                                <% } %>
                                <div class="image-overlay">
                                    <button class="zoom-btn" type="button" aria-label="Zoom image">
                                        <i class="fas fa-search-plus"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </section>

                    <section class="product-info-card">
                        <div class="product-header">
                            <div class="product-label-row">
                                <span class="product-eyebrow">ARNI Collection</span>
                                <button class="wishlist-btn" type="button" aria-label="Add to wishlist">
                                    <i class="far fa-heart"></i>
                                </button>
                            </div>

                            <h1><%= product.name %></h1>

                            <div class="rating-section">
                                <div class="stars" aria-label="Rating <%= product.review %> out of 5">
                                    <% for(let i = 1; i <= 5; i++) { %>
                                        <% if(i <= Math.floor(product.review)) { %>
                                            <i class="fas fa-star"></i>
                                        <% } else if(i <= Math.ceil(product.review) && product.review % 1 !== 0) { %>
                                            <i class="fas fa-star-half-alt"></i>
                                        <% } else { %>
                                            <i class="far fa-star"></i>
                                        <% } %>
                                    <% } %>
                                </div>
                                <span class="review-count"><%= product.review %> rating · 128 reviews</span>
                            </div>

                            <p class="price">
                                <span class="current-price">₹<%= product.discountPrice %></span>
                                <% if (product.price !== product.discountPrice) { %>
                                    <span class="original-price">₹<%= product.price %></span>
                                    <span class="discount-percentage">
                                        <%= Math.round((1 - product.discountPrice / product.price) * 100) %>% OFF
                                    </span>
                                <% } %>
                            </p>

                            <% const totalStock = Object.values(variant.sizes || {}).reduce((a, b) => a + b, 0); %>
                            <% const stockStatusClass = totalStock === 0 ? 'low' : totalStock <= 30 ? 'medium' : 'high'; %>
                            <div class="stock-info">
                                <i class="fas fa-box"></i>
                                <span class="stock-count"><%= totalStock %></span> items in stock
                                <span class="stock-status <%= stockStatusClass %>">
                                    <%= totalStock === 0 ? 'Out of Stock' : totalStock <= 30 ? 'Limited Stock' : 'In Stock' %>
                                </span>
                            </div>
                        </div>

                        <div class="product-description">
                            <h3>Description</h3>
                            <p><%= product.description %></p>
                        </div>

                        <div class="variant-section">
                            <h3>Choose Size</h3>
                            <div class="size-options">
                                <% Object.entries(variant.sizes || {}).forEach(([size, count], index) => { %>
                                    <button class="size-btn <%= index === 0 ? 'active' : '' %> <%= count === 0 ? 'out-of-stock' : '' %>"
                                            type="button"
                                            data-size="<%= size %>"
                                            data-stock="<%= count %>">
                                        <%= size %>
                                    </button>
                                <% }); %>
                            </div>
                        </div>

                        <div class="variant-section">
                            <h3>Choose Color</h3>
                            <div class="color-options">
                                <% allVariants.forEach(v => { %>
                                    <button
    class="color-btn <%= v._id.toString() === variant._id.toString() ? 'active' : '' %>"
    type="button"
    data-variant-id="<%= v._id %>"
    data-color-value="<%= v.color || '#d1d5db' %>"
    data-color="<%= v.color || 'Color' %>"
    title="<%= v.color || 'Color' %>"
    aria-label="Select <%= v.color || 'color' %>">
</button>
                                <% }); %>
                            </div>
                        </div>

                        <div class="purchase-section">
                            <div class="quantity-section">
                                <button class="quantity-btn minus" type="button" aria-label="Decrease quantity"><i class="fas fa-minus"></i></button>
                                <input type="number" id="quantity" class="quantity-input" value="1" min="1">
                                <button class="quantity-btn plus" type="button" aria-label="Increase quantity"><i class="fas fa-plus"></i></button>
                            </div>
                            <button class="add-to-cart" id="add-to-cart" type="button">
                                <i class="fas fa-shopping-cart"></i>
                                Add to Cart
                            </button>
                        </div>

                        <div class="trust-grid">
                            <div class="trust-item"><i class="fas fa-truck"></i><span>Fast Delivery</span></div>
                            <div class="trust-item"><i class="fas fa-rotate-left"></i><span>Easy Returns</span></div>
                            <div class="trust-item"><i class="fas fa-shield-alt"></i><span>Secure Checkout</span></div>
                        </div>
                    </section>
                </div>
            </div>
        </section>

        <!-- ========== RELATED PRODUCTS ========== -->
        <section class="section related-products">
            <div class="container">
                <div class="section-header between">
                    <div>
                        <p class="section-eyebrow">Curated for you</p>
                        <h2 class="section-title">You May Also Like</h2>
                    </div>
                    <a href="/shop" class="view-all-btn">View All <i class="fas fa-arrow-right"></i></a>
                </div>

                <% if (relatedProducts && relatedProducts.length) { %>
                    <div class="products-grid">
                        <% relatedProducts.forEach(product => { %>
                            <a href="/overview/<%= product._id %>" class="product-card-link">
                                <article class="product-card">
                                    <div class="product-image-container">
                                        <img src="<%= product.images %>" alt="<%= product.productDetails.name %>" class="product-image" loading="lazy">
                                        <div class="product-overlay"><span>Quick View</span></div>
                                    </div>
                                    <div class="related-product-info">
                                        <h3 class="product-name"><%= product.productDetails.name %></h3>
                                        <div class="price-layout">
                                            <div class="price-row">
                                                <span class="discount-price">₹<%= product.productDetails.discountPrice %></span>
                                                <% if (product.productDetails.price !== product.productDetails.discountPrice) { %>
                                                    <span class="related-original-price">₹<%= product.productDetails.price %></span>
                                                <% } %>
                                            </div>
                                            <% if (product.productDetails.price !== product.productDetails.discountPrice) { %>
                                                <span class="related-discount-percentage">
                                                    <%= Math.round((1 - product.productDetails.discountPrice / product.productDetails.price) * 100) %>% OFF
                                                </span>
                                            <% } %>
                                        </div>
                                    </div>
                                </article>
                            </a>
                        <% }); %>
                    </div>
                <% } else { %>
                    <div class="empty-state">
                        <i class="fas fa-shirt"></i>
                        <h3>No related products yet</h3>
                        <p>Explore the shop to find more ARNI styles.</p>
                        <a href="/shop" class="btn-pill">Explore Shop</a>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <!-- ========== FOOTER ========== -->
    <footer class="footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <span class="footer-logo">ARNI</span>
                    <p>Fashion for everyone. Curated with intention.</p>
                </div>
                <div class="footer-col">
                    <h4>Navigate</h4>
                    <a href="/">Home</a>
                    <a href="/shop">Shop</a>
                    <a href="/users/cart">Cart</a>
                </div>
                <div class="footer-col">
                    <h4>Help</h4>
                    <a href="/auth/terms">Returns & Terms</a>
                    <a href="/auth/privacy">Privacy</a>
                    <a href="mailto:info@arni.com">Contact Us</a>
                </div>
                <div class="footer-col">
                    <h4>Connect</h4>
                    <a href="mailto:info@arni.com">Email ARNI</a>
                </div>
            </div>
            <div class="footer-bottom">
                <span>© <%= new Date().getFullYear() %> ARNI. All rights reserved.</span>
                <span>info@arni.com</span>
            </div>
        </div>
    </footer>

    <script id="arni-categories-data" type="application/json">
        <%- JSON.stringify(categoriesWithSubs || []) %>
    </script>
    <script src="/javascripts/index/overview.js"></script>
</body>
</html>
