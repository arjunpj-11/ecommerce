<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Login - ARNI</title>

  <link rel="stylesheet" href="/stylesheets/authentication/login.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <main class="login-container">
    <section class="login-box">
      <a href="/" class="logo-section" aria-label="Go to ARNI home">
        <img src="/images/common/logo.png" alt="ARNI Logo" />
      </a>

      <div class="image-section">
        <img src="/images/authentication/signin image.jpg" alt="Login Image" />

        <div class="image-overlay">
          <span>Welcome Back</span>
          <h1>Continue your ARNI journey</h1>
          <p>Login to explore your cart, wishlist, orders, and curated fashion picks.</p>
        </div>
      </div>

      <div class="form-section">
        <div class="form-header">
          <p class="eyebrow">Account Access</p>
          <h2>Login</h2>
          <p class="form-subtitle">Enter your email or phone number and password.</p>
        </div>

        <form id="form" novalidate>
          <% if (emailError) { %>
            <input
              type="text"
              name="emailOrPhone"
              placeholder="Email or Phone Number"
              id="emailOrPhone"
              value="<%= detail.emailOrPhone %>"
              required
            />
            <p class="validation iValid" id="emailOrPhoneMessage"><%= emailError %></p>
          <% } else { %>
            <input
              type="text"
              name="emailOrPhone"
              placeholder="Email or Phone Number"
              id="emailOrPhone"
              value="<%= detail.emailOrPhone %>"
              required
            />
            <p class="validation iValid" id="emailOrPhoneMessage"></p>
          <% } %>

          <div class="password-wrapper">
            <input
              type="password"
              name="password"
              placeholder="Password"
              id="password"
              required
            />
            <button type="button" class="password-toggle" id="togglePassword" aria-label="Show password">
              <i class="fas fa-eye"></i>
            </button>
          </div>

          <p class="validation iValid" id="passwordMessage"><%= error %></p>

          <button type="submit" class="submit-btn">
            <i class="fas fa-right-to-bracket"></i>
            Login
          </button>
        </form>

        <div class="form-links">
          <a href="/auth/forgetPassword" class="forgot-password">Forgot Password?</a>
          <span>|</span>
          <a href="/auth/signin" class="signup">Sign Up</a>
        </div>

        <div class="social-login">
          <p>Or login with</p>

          <div class="social-actions">
            <a href="/api/google/auth/google" class="social-btn google">
              <i class="fab fa-google"></i>
              Google
            </a>

            <a href="/api/facebook/auth/facebook" class="social-btn facebook">
              <i class="fab fa-facebook-f"></i>
              Facebook
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>

  <script src="/javascripts/authentication/login.js"></script>
</body>
</html>