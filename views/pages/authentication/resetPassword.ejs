<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Reset Password - ARNI</title>

  <link rel="stylesheet" href="/stylesheets/authentication/resetPassword.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <main class="login-container">
    <section class="login-box">
      <a href="/" class="logo-section" aria-label="Go to ARNI home">
        <img src="/images/common/logo.png" alt="ARNI Logo" />
      </a>

      <div class="image-section">
        <img src="/images/authentication/signin image.jpg" alt="Reset Password Image" />

        <div class="image-overlay">
          <span>New Password</span>
          <h1>Create a stronger ARNI password</h1>
          <p>Choose a secure password to protect your account, orders, cart, and wishlist.</p>
        </div>
      </div>

      <div class="form-section">
        <div class="form-header">
          <p class="eyebrow">Account Security</p>
          <h2>Reset Password</h2>
          <p class="form-subtitle">Enter and confirm your new password.</p>
        </div>

        <form id="form" novalidate>
          <div class="password-wrapper">
            <input
              type="password"
              name="newPassword"
              placeholder="New Password"
              id="password"
              required
            />

            <button type="button" class="password-toggle" id="togglePassword" aria-label="Show password">
              <i class="fas fa-eye"></i>
            </button>
          </div>
          <p class="validation iValid" id="passwordMessage"></p>

          <div class="password-wrapper">
            <input
              type="password"
              name="confirm-password"
              placeholder="Confirm Password"
              id="passwordConfirm"
              required
            />

            <button type="button" class="password-toggle" id="togglePasswordConfirm" aria-label="Show confirm password">
              <i class="fas fa-eye"></i>
            </button>
          </div>
          <p class="validation iValid" id="passwordConfirmMessage"></p>

          <div class="password-criteria">
            <p>Password must include:</p>
            <ul>
              <li id="criteria-length">At least 8 characters</li>
              <li id="criteria-uppercase">One uppercase letter</li>
              <li id="criteria-lowercase">One lowercase letter</li>
              <li id="criteria-number">One number</li>
              <li id="criteria-special">One special character</li>
            </ul>
          </div>

          <button type="submit" class="submit-btn">
            <i class="fas fa-lock"></i>
            Reset Password
          </button>
        </form>

        <div class="form-links">
          <a href="/auth/login" class="back-to-login">
            <i class="fas fa-arrow-left"></i>
            Back to Login
          </a>
        </div>
      </div>
    </section>
  </main>

  <script src="/javascripts/authentication/resetPassword.js"></script>
</body>
</html>