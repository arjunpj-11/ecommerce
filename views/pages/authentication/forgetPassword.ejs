<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Forgot Password - ARNI</title>

  <link rel="stylesheet" href="/stylesheets/authentication/forgetPassword.css" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <main class="login-container">
    <section class="login-box">
      <a href="/" class="logo-section" aria-label="Go to ARNI home">
        <img src="/images/common/logo.png" alt="ARNI Logo" />
      </a>

      <div class="image-section">
        <img src="/images/authentication/signin image.jpg" alt="Forgot Password Image" />

        <div class="image-overlay">
          <span>Account Recovery</span>
          <h1>Reset your ARNI password</h1>
          <p>Enter your registered email address and we’ll send a code to verify your account.</p>
        </div>
      </div>

      <div class="form-section">
        <div class="form-header">
          <p class="eyebrow">Forgot Password</p>
          <h2>Recover Account</h2>
          <p class="form-subtitle">
            Enter your email address to receive a verification code.
          </p>
        </div>

        <form action="/auth/forgetPassword/sendOtp" method="POST" id="form" novalidate>
          <div class="input-wrapper">
            <i class="fas fa-envelope"></i>
            <input
              type="text"
              name="emailOrPhone"
              placeholder="Email Address"
              id="emailOrPhone"
              value="<%= typeof detail !== 'undefined' && detail.emailOrPhone ? detail.emailOrPhone : '' %>"
              autocomplete="email"
              inputmode="email"
              required
            />
          </div>

          <% if (error) { %>
            <p class="validation iValid" id="emailOrPhoneMessage"><%= error %></p>
          <% } else { %>
            <p class="validation iValid" id="emailOrPhoneMessage"></p>
          <% } %>

          <button type="submit" class="submit-btn">
            <i class="fas fa-paper-plane"></i>
            Send OTP
          </button>
        </form>

        <div class="login-link">
          <p>
            Remembered your password?
            <a href="/auth/login">Log in here</a>
          </p>
        </div>
      </div>
    </section>
  </main>

  <script src="/javascripts/authentication/forgetPassword.js"></script>
</body>
</html>
