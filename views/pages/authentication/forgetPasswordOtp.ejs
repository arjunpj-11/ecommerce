<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Reset Password OTP - ARNI</title>

  <link rel="stylesheet" href="/stylesheets/authentication/forgetPasswordOtp.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <main class="login-container">
    <section class="login-box">
      <a href="/" class="logo-section" aria-label="Go to ARNI home">
        <img src="/images/common/logo.png" alt="ARNI Logo" />
      </a>

      <div class="image-section">
        <img src="/images/authentication/signin image.jpg" alt="Password Reset OTP" />

        <div class="image-overlay">
          <span>Password Reset</span>
          <h1>Verify your reset request</h1>
          <p>Enter the 6-digit OTP sent to your registered email or phone number.</p>
        </div>
      </div>

      <div class="form-section">
        <div class="form-header">
          <p class="eyebrow">Security Check</p>
          <h2>Enter OTP</h2>
          <p class="form-subtitle">Please enter the 6-digit code we sent you.</p>
        </div>

        <div class="otp-sent-message">
          <p>We have sent an OTP to <strong><%= value %></strong></p>
        </div>

        <% if (error) { %>
          <div class="error-message">
            <i class="fas fa-circle-exclamation"></i>
            <span><%= error %></span>
          </div>
        <% } %>

        <form action="/auth/forgetPasswordOtp/verify-otp" method="post" class="otp-form">
          <div class="otp-inputs">
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="otp1" name="otp1" required autocomplete="one-time-code" />
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="otp2" name="otp2" required />
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="otp3" name="otp3" required />
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="otp4" name="otp4" required />
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="otp5" name="otp5" required />
            <input type="text" inputmode="numeric" pattern="[0-9]*" maxlength="1" id="otp6" name="otp6" required />
          </div>

          <button type="submit" class="submit-btn">
            <i class="fas fa-shield-halved"></i>
            Verify OTP
          </button>
        </form>

        <div class="form-links">
          <span>Didn't receive the OTP?</span>
          <button type="button" id="resendBtn" class="resend-otp">Resend OTP</button>
          <span id="timer" class="timer"></span>
        </div>

        <div class="form-links">
          <a href="/auth/forgetPassword" class="back-to-login">
            <i class="fas fa-arrow-left"></i>
            Back to Forgot Password
          </a>
        </div>
      </div>
    </section>
  </main>

  <script src="/javascripts/authentication/forgetPasswordOtp.js"></script>
</body>
</html>