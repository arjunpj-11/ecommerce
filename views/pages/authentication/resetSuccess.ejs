<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Password Reset Successful - ARNI</title>

  <link rel="stylesheet" href="/stylesheets/authentication/resetSuccess.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <main class="success-page">
    <section class="success-card">
      <a href="/" class="logo-section" aria-label="Go to ARNI home">
        <img src="/images/common/logo.png" alt="ARNI Logo" />
      </a>

      <div class="success-icon">
        <i class="fas fa-check"></i>
      </div>

      <p class="eyebrow">Password Updated</p>

      <h1>Password Reset Successful!</h1>

      <p class="success-message">
        Your password has been successfully updated. You can now log in with your new password.
      </p>

      <a href="/auth/login" class="btn">
        <i class="fas fa-right-to-bracket"></i>
        Go to Login
      </a>
    </section>
  </main>

  <script src="/javascripts/authentication/resetSuccess.js"></script>
</body>
</html>