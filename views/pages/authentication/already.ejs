<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <% if (isNaN(value)) { %>
    <title>Email Already in Use - ARNI</title>
  <% } else { %>
    <title>Phone Number Already in Use - ARNI</title>
  <% } %>

  <link rel="stylesheet" href="/stylesheets/authentication/already.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <main class="already-page">
    <section class="already-card">
      <a href="/" class="logo-section" aria-label="Go to ARNI home">
        <img src="/images/common/logo.png" alt="ARNI Logo" />
      </a>

      <div class="already-icon">
        <i class="fas fa-user-lock"></i>
      </div>

      <p class="eyebrow">Account Exists</p>

      <% if (isNaN(value)) { %>
        <h1>Email Already in Use</h1>

        <p class="already-message">
          This email address is already associated with an ARNI account. Please log in instead.
        </p>
      <% } else { %>
        <h1>Phone Number Already in Use</h1>

        <p class="already-message">
          This phone number is already associated with an ARNI account. Please log in instead.
        </p>
      <% } %>

      <div class="already-actions">
        <a href="/auth/signin" class="btn-secondary">
          <i class="fas fa-arrow-left"></i>
          Back to Sign Up
        </a>

        <a href="/auth/login" class="btn-primary">
          <i class="fas fa-right-to-bracket"></i>
          Go to Login
        </a>
      </div>
    </section>
  </main>

  <script src="/javascripts/authentication/already.js"></script>
</body>
</html>