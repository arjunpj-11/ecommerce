<%
  const safeCategories = typeof categoriesWithSubs !== 'undefined' && Array.isArray(categoriesWithSubs)
    ? categoriesWithSubs
    : [];

  const safeAddresses = typeof addresses !== 'undefined' && Array.isArray(addresses)
    ? addresses
    : [];

  const safeUser = typeof user !== 'undefined' && user
    ? user
    : {};

  const profileImage =
    safeUser.profileImage ||
    safeUser.avatarUrl ||
    safeUser.image ||
    '/images/avatars/avatar-1.svg';
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Manage Addresses - ARNI</title>

  <link rel="stylesheet" href="/stylesheets/user/profile.css" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <header class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="/" class="logo">ARNI</a>

      <nav class="nav-links" id="navLinks">
        <a href="/" class="nav-link">Home</a>
        <a href="/shop" class="nav-link">Shop</a>

        <% if (safeCategories.length > 0) { %>
          <a href="/shop" class="nav-link has-dropdown" data-category="true">
            Categories
            <i class="fas fa-chevron-down dropdown-arrow"></i>
          </a>
        <% } %>
      </nav>

      <div class="nav-actions">
        <button class="icon-btn search-toggle" type="button" aria-label="Search">
          <i class="fas fa-search"></i>
        </button>

        <a href="/users/cart" class="icon-btn" aria-label="Cart">
          <i class="fas fa-shopping-bag"></i>
        </a>

        <a href="/users/pI" class="icon-btn profile-btn" aria-label="Profile">
          <i class="fas fa-user"></i>
        </a>

        <button class="hamburger" id="hamburger" type="button" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <div class="search-overlay" id="searchOverlay">
      <form class="search-form" action="/search" method="GET">
        <input
          type="text"
          name="search"
          placeholder="Search for products, styles, brands..."
          class="search-input"
        />

        <button type="submit" class="search-submit" aria-label="Submit search">
          <i class="fas fa-search"></i>
        </button>

        <button type="button" class="search-close" id="searchClose" aria-label="Close search">
          <i class="fas fa-times"></i>
        </button>
      </form>
    </div>
  </header>

  <div class="mobile-overlay" id="mobileOverlay"></div>

  <aside class="mobile-drawer" id="mobileDrawer">
    <button class="drawer-close" id="drawerClose" type="button" aria-label="Close menu">
      <i class="fas fa-times"></i>
    </button>

    <div class="drawer-logo">ARNI</div>

    <nav class="drawer-nav">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/users/cart">Cart</a>
      <a href="/users/pI">Profile</a>

      <% safeCategories.forEach(function(category) { %>
        <a href="/subcategories?main=<%= category._id %>">
          <%= category.mainCategoryName %>
        </a>
      <% }); %>
    </nav>
  </aside>

  <main class="profile-page">
    <section class="profile-hero">
      <p class="section-eyebrow">My Account</p>
      <h1>Manage Addresses</h1>
      <p>Add, edit, delete, and choose your default delivery address for faster checkout.</p>
    </section>

    <section class="profile-layout">
      <aside class="sidebar">
        <div class="profile-card">
          <div class="profile-image-container">
            <img
              src="<%= profileImage %>"
              alt="<%= safeUser.username || 'User' %>"
              class="profile-image"
            />
          </div>

          <p class="hello-text">Hello,</p>
          <h2><%= safeUser.username || 'ARNI User' %></h2>
          <p class="profile-subtitle">Manage your saved delivery locations.</p>
        </div>

        <nav class="account-nav">
          <a class="account-nav-link" href="/users/pI" data-page="personal">
            <i class="fas fa-user"></i>
            Personal Information
          </a>

          <a class="account-nav-link" href="/users/order" data-page="orders">
            <i class="fas fa-box"></i>
            My Orders
          </a>

          <a class="account-nav-link" href="/users/wishlist" data-page="wishlist">
            <i class="fas fa-heart"></i>
            My Wishlist
          </a>

          <a class="account-nav-link active" href="/users/adr" data-page="addresses">
            <i class="fas fa-location-dot"></i>
            Manage Addresses
          </a>

          <a class="account-nav-link" href="/users/wallet" data-page="wallet">
            <i class="fas fa-wallet"></i>
            Wallet
          </a>

          <form action="/users/logout" method="POST">
            <button type="submit" class="account-nav-link logout-btn" id="logoutBtn">
              <i class="fas fa-right-from-bracket"></i>
              Log Out
            </button>
          </form>
        </nav>
      </aside>

      <section class="content-area">
        <div class="page active" id="addresses">
          <div class="page-header">
            <div>
              <p class="card-eyebrow">Delivery Details</p>
              <h2>Saved Addresses</h2>
            </div>

            <button class="edit-button" id="addAddressBtn" type="button">
              <i class="fas fa-plus"></i>
              Add New Address
            </button>
          </div>

          <div class="address-form" id="createAddressFormContainer">
            <div class="address-form-header">
              <div>
                <p class="card-eyebrow">New Address</p>
                <h3>Add New Address</h3>
              </div>

              <button class="close-form" id="closeCreateFormBtn" type="button" aria-label="Close add address form">
                <i class="fas fa-times"></i>
              </button>
            </div>

            <form id="createAddressForm" class="address-form-grid">
              <div class="form-group">
                <label>Street*</label>
                <input type="text" name="street" required />
              </div>

              <div class="form-group">
                <label>City*</label>
                <input type="text" name="city" required />
              </div>

              <div class="form-group">
                <label>State*</label>
                <input type="text" name="state" required />
              </div>

              <div class="form-group">
                <label>Postal Code*</label>
                <input type="text" name="postalCode" required pattern="[0-9]{6}" />
              </div>

              <div class="form-group">
                <label>Country*</label>
                <input type="text" name="country" required />
              </div>

              <div class="form-group full">
                <label class="checkbox-label">
                  <input type="checkbox" name="isPrimary" />
                  Set as default address
                </label>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn-primary">
                  Save Address
                </button>

                <button type="button" class="btn-outline" id="cancelCreateFormBtn">
                  Cancel
                </button>
              </div>
            </form>
          </div>

          <div class="address-form" id="editAddressFormContainer">
            <div class="address-form-header">
              <div>
                <p class="card-eyebrow">Update Address</p>
                <h3>Edit Address</h3>
              </div>

              <button class="close-form" id="closeEditFormBtn" type="button" aria-label="Close edit address form">
                <i class="fas fa-times"></i>
              </button>
            </div>

            <form id="editAddressForm" class="address-form-grid">
              <input type="hidden" name="id" />

              <div class="form-group">
                <label>Street*</label>
                <input type="text" name="street" required />
              </div>

              <div class="form-group">
                <label>City*</label>
                <input type="text" name="city" required />
              </div>

              <div class="form-group">
                <label>State*</label>
                <input type="text" name="state" required />
              </div>

              <div class="form-group">
                <label>Postal Code*</label>
                <input type="text" name="postalCode" required pattern="[0-9]{6}" />
              </div>

              <div class="form-group">
                <label>Country*</label>
                <input type="text" name="country" required />
              </div>

              <div class="form-group full">
                <label class="checkbox-label">
                  <input type="checkbox" name="isPrimary" />
                  Set as default address
                </label>
              </div>

              <div class="form-actions">
                <button type="submit" class="btn-primary">
                  Update Address
                </button>

                <button type="button" class="btn-outline" id="cancelEditFormBtn">
                  Cancel
                </button>
              </div>
            </form>
          </div>

          <% if (safeAddresses.length === 0) { %>
            <div class="empty-address-state">
              <div class="empty-icon">
                <i class="fas fa-location-dot"></i>
              </div>

              <h3>No saved addresses yet</h3>
              <p>Add your first delivery address to make checkout faster.</p>
            </div>
          <% } else { %>
            <div class="address-grid" id="addressGrid">
              <% safeAddresses.forEach(address => { %>
                <article
                  class="address-card <%= address.isPrimary ? 'default' : '' %>"
                  data-id="<%= address._id %>"
                  data-street="<%= address.street %>"
                  data-city="<%= address.city %>"
                  data-state="<%= address.state %>"
                  data-postal-code="<%= address.postalCode %>"
                  data-country="<%= address.country %>"
                  data-primary="<%= address.isPrimary ? 'true' : 'false' %>"
                >
                  <% if (address.isPrimary) { %>
                    <span class="default-badge">
                      <i class="fas fa-check"></i>
                      Default
                    </span>
                  <% } %>

                  <div class="address-icon">
                    <i class="fas fa-location-dot"></i>
                  </div>

                  <div class="address-info">
                    <p><%= address.street %></p>
                    <p><%= address.city %>, <%= address.state %> <%= address.postalCode %></p>
                    <p><%= address.country %></p>
                  </div>

                  <div class="address-actions">
                    <button class="address-button edit-address" type="button">
                      <i class="fas fa-pen"></i>
                      Edit
                    </button>

                    <button class="address-button delete-address" type="button">
                      <i class="fas fa-trash"></i>
                      Delete
                    </button>

                    <% if (!address.isPrimary) { %>
                      <button class="address-button set-default" type="button">
                        <i class="fas fa-star"></i>
                        Set Default
                      </button>
                    <% } %>
                  </div>
                </article>
              <% }); %>
            </div>
          <% } %>
        </div>
      </section>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-content">
      <div class="footer-section footer-brand">
        <h3>ARNI</h3>
        <p>Fashion for everyone. Curated with intention.</p>
      </div>

      <div class="footer-section">
        <h3>Quick Links</h3>
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/users/cart">Cart</a>
      </div>

      <div class="footer-section">
        <h3>Contact Us</h3>
        <p>Email: info@arni.com</p>
      </div>

      <div class="footer-section">
        <h3>Follow Us</h3>
        <div class="social-links">
          <a href="mailto:info@arni.com">Email ARNI</a>
        </div>
      </div>
    </div>
  </footer>

  <script id="arni-categories-data" type="application/json">
    <%- JSON.stringify(safeCategories || []) %>
  </script>

  <script src="/javascripts/user/manageAddress.js"></script>
</body>
</html>
