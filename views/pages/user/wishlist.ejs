<%
  const safeCategories = typeof categoriesWithSubs !== 'undefined' && Array.isArray(categoriesWithSubs)
    ? categoriesWithSubs
    : [];

  const safeWishlistItems = typeof wishlistItems !== 'undefined' && Array.isArray(wishlistItems)
    ? wishlistItems
    : [];

  const safeUser = typeof user !== 'undefined' && user
    ? user
    : {};

  const profileImage =
    safeUser.profileImage ||
    safeUser.avatarUrl ||
    safeUser.image ||
    '/images/avatars/avatar-1.svg';
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>My Wishlist - ARNI</title>

  <link rel="stylesheet" href="/stylesheets/user/profile.css" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <header class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="/" class="logo">ARNI</a>

      <nav class="nav-links" id="navLinks">
        <a href="/" class="nav-link">Home</a>
        <a href="/shop" class="nav-link">Shop</a>

        <% if (safeCategories.length > 0) { %>
          <a href="/shop" class="nav-link has-dropdown" data-category="true">
            Categories
            <i class="fas fa-chevron-down dropdown-arrow"></i>
          </a>
        <% } %>
      </nav>

      <div class="nav-actions">
        <button class="icon-btn search-toggle" type="button" aria-label="Search">
          <i class="fas fa-search"></i>
        </button>

        <a href="/users/cart" class="icon-btn" aria-label="Cart">
          <i class="fas fa-shopping-bag"></i>
        </a>

        <a href="/users/pI" class="icon-btn profile-btn active" aria-label="Profile">
          <i class="fas fa-user"></i>
        </a>

        <button class="hamburger" id="hamburger" type="button" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <div class="search-overlay" id="searchOverlay">
      <form class="search-form" action="/search" method="GET">
        <input
          type="text"
          name="search"
          placeholder="Search for products, styles, brands..."
          class="search-input"
        />

        <button type="submit" class="search-submit" aria-label="Submit search">
          <i class="fas fa-search"></i>
        </button>

        <button type="button" class="search-close" id="searchClose" aria-label="Close search">
          <i class="fas fa-times"></i>
        </button>
      </form>
    </div>
  </header>

  <div class="mobile-overlay" id="mobileOverlay"></div>

  <aside class="mobile-drawer" id="mobileDrawer">
    <button class="drawer-close" id="drawerClose" type="button" aria-label="Close menu">
      <i class="fas fa-times"></i>
    </button>

    <div class="drawer-logo">ARNI</div>

    <nav class="drawer-nav">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/users/cart">Cart</a>
      <a href="/users/pI">Profile</a>

      <% safeCategories.forEach(function(category) { %>
        <a href="/subcategories?main=<%= category._id %>">
          <%= category.mainCategoryName %>
        </a>
      <% }); %>
    </nav>
  </aside>

  <main class="profile-page">
    <section class="profile-hero reveal">
      <p class="section-eyebrow">My Account</p>
      <h1>My Wishlist</h1>
      <p>Save your favorite ARNI picks, view product details, and move items to your cart whenever you are ready.</p>
    </section>

    <section class="profile-layout">
      <aside class="sidebar reveal">
        <div class="profile-card">
          <div class="profile-image-container">
            <img
              src="<%= profileImage %>"
              alt="<%= safeUser.username || 'User' %>"
              class="profile-image"
            />
          </div>

          <p class="hello-text">Hello,</p>
          <h2><%= safeUser.username || 'ARNI User' %></h2>
          <p class="profile-subtitle">Your saved fashion picks are waiting here.</p>
        </div>

        <nav class="account-nav">
          <a class="account-nav-link" href="/users/pI" data-page="personal">
            <i class="fas fa-user"></i>
            Personal Information
          </a>

          <a class="account-nav-link" href="/users/order" data-page="orders">
            <i class="fas fa-box"></i>
            My Orders
          </a>

          <a class="account-nav-link active" href="/users/wishlist" data-page="wishlist">
            <i class="fas fa-heart"></i>
            My Wishlist
          </a>

          <a class="account-nav-link" href="/users/adr" data-page="addresses">
            <i class="fas fa-location-dot"></i>
            Manage Addresses
          </a>

          <a class="account-nav-link" href="/users/wallet" data-page="wallet">
            <i class="fas fa-wallet"></i>
            Wallet
          </a>

          <form action="/users/logout" method="POST">
            <button type="submit" class="account-nav-link logout-btn" id="logoutBtn">
              <i class="fas fa-right-from-bracket"></i>
              Log Out
            </button>
          </form>
        </nav>
      </aside>

      <section class="content-area reveal">
        <div class="page active" id="wishlist">
          <div class="page-header">
            <div>
              <p class="card-eyebrow">Saved Products</p>
              <h2>Your Wishlist</h2>
            </div>

            <a href="/shop" class="edit-button">
              <i class="fas fa-bag-shopping"></i>
              Continue Shopping
            </a>
          </div>

          <div class="wishlist-grid" id="wishlistGrid">
            <% if (safeWishlistItems.length > 0) { %>
              <% safeWishlistItems.forEach(item => {
                const variant = item.variantId || {};
                const product = item.product || {};
                const image = Array.isArray(variant.images) && variant.images.length > 0
                  ? variant.images[0]
                  : '/images/placeholder-product.png';
              %>
                <article class="wishlist-item reveal" data-variant-id="<%= variant._id %>">
                  <div class="wishlist-image">
                    <img src="<%= image %>" alt="<%= product.name || 'Wishlist product' %>" />
                  </div>

                  <div class="wishlist-content">
                    <p class="wishlist-label">Favorite Pick</p>

                    <h3 class="wishlist-title">
                      <%= product.name || 'Product Name' %>
                    </h3>

                    <div class="wishlist-price">
                      ₹<%= Number(product.price || 0).toLocaleString() %>
                    </div>

                    <div class="wishlist-actions">
                      <button class="wishlist-button remove-wishlist" type="button">
                        <i class="fas fa-trash"></i>
                        Remove
                      </button>

                      <a href="/overview/<%= variant._id %>" class="wishlist-button details-button">
                        <i class="fas fa-eye"></i>
                        More Details
                      </a>
                    </div>
                  </div>
                </article>
              <% }); %>
            <% } else { %>
              <div class="empty-wishlist">
                <div class="empty-icon">
                  <i class="fas fa-heart"></i>
                </div>

                <h3>Your wishlist is empty</h3>
                <p>Save products you love and come back to them anytime.</p>

                <a href="/shop" class="btn-primary shop-now-btn">
                  Shop Now
                </a>
              </div>
            <% } %>
          </div>
        </div>
      </section>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-content">
      <div class="footer-section footer-brand">
        <h3>ARNI</h3>
        <p>Fashion for everyone. Curated with intention.</p>
      </div>

      <div class="footer-section">
        <h3>Quick Links</h3>
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/users/cart">Cart</a>
      </div>

      <div class="footer-section">
        <h3>Contact Us</h3>
        <p>Email: info@arni.com</p>
      </div>

      <div class="footer-section">
        <h3>Follow Us</h3>
        <div class="social-links">
          <a href="mailto:info@arni.com">Email ARNI</a>
        </div>
      </div>
    </div>
  </footer>

  <div class="toast-container" id="toastContainer"></div>

  <script id="arni-categories-data" type="application/json">
    <%- JSON.stringify(safeCategories || []) %>
  </script>

  <script src="/javascripts/user/wishlist.js"></script>
</body>
</html>
