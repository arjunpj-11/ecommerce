<%
  const safeCategories = typeof categoriesWithSubs !== 'undefined' && Array.isArray(categoriesWithSubs)
    ? categoriesWithSubs
    : [];

  const safeUser = typeof user !== 'undefined' && user
    ? user
    : {};

  const avatarOptions = [
    '/images/avatars/avatar-1.svg',
    '/images/avatars/avatar-2.svg',
    '/images/avatars/avatar-3.svg',
    '/images/avatars/avatar-4.svg',
    '/images/avatars/avatar-5.svg',
    '/images/avatars/avatar-6.svg',
    '/images/avatars/avatar-7.svg',
    '/images/avatars/avatar-8.svg'
  ];

  const profileImage =
    safeUser.profileImage ||
    safeUser.avatarUrl ||
    safeUser.image ||
    avatarOptions[0];
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>Profile - ARNI</title>

  <link rel="stylesheet" href="/stylesheets/user/profile.css" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <header class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="/" class="logo">ARNI</a>

      <nav class="nav-links" id="navLinks">
        <a href="/" class="nav-link">Home</a>
        <a href="/shop" class="nav-link">Shop</a>

        <% if (safeCategories.length > 0) { %>
          <a href="/shop" class="nav-link has-dropdown" data-category="true">
            Categories
            <i class="fas fa-chevron-down dropdown-arrow"></i>
          </a>
        <% } %>
      </nav>

      <div class="nav-actions">
        <button class="icon-btn search-toggle" type="button" aria-label="Search">
          <i class="fas fa-search"></i>
        </button>

        <a href="/users/cart" class="icon-btn" aria-label="Cart">
          <i class="fas fa-shopping-bag"></i>
        </a>

        <a href="/users/pI" class="icon-btn active" aria-label="Profile">
          <i class="fas fa-user"></i>
        </a>

        <button class="hamburger" id="hamburger" type="button" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <div class="search-overlay" id="searchOverlay">
      <form class="search-form" action="/search" method="GET">
        <input
          type="text"
          name="search"
          placeholder="Search for products, styles, brands..."
          class="search-input"
        />

        <button type="submit" class="search-submit" aria-label="Submit search">
          <i class="fas fa-search"></i>
        </button>

        <button type="button" class="search-close" id="searchClose" aria-label="Close search">
          <i class="fas fa-times"></i>
        </button>
      </form>
    </div>
  </header>

  <div class="mobile-overlay" id="mobileOverlay"></div>

  <aside class="mobile-drawer" id="mobileDrawer">
    <button class="drawer-close" id="drawerClose" type="button" aria-label="Close menu">
      <i class="fas fa-times"></i>
    </button>

    <div class="drawer-logo">ARNI</div>

    <nav class="drawer-nav">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/users/cart">Cart</a>
      <a href="/users/pI">Profile</a>

      <% safeCategories.forEach(function(category) { %>
        <a href="/subcategories?main=<%= category._id %>">
          <%= category.mainCategoryName %>
        </a>
      <% }); %>
    </nav>
  </aside>

  <main class="profile-page">
    <section class="profile-hero">
      <p class="section-eyebrow">My Account</p>
      <h1>Profile Settings</h1>
      <p>Manage your personal information, orders, wishlist, addresses, wallet, and account preferences.</p>
    </section>

    <section class="profile-layout">
      <aside class="sidebar">
        <div class="profile-card">
          <div class="profile-image-container">
            <img
              src="<%= profileImage %>"
              alt="<%= safeUser.username || 'User' %>"
              class="profile-image"
            />

            <button type="button" class="change-photo-btn" aria-label="Choose avatar">
              <i class="fas fa-face-smile"></i>
            </button>
          </div>

          <p class="hello-text">Hello,</p>
          <h2><%= safeUser.username || 'ARNI User' %></h2>
          <p class="profile-subtitle">Welcome back to your ARNI account.</p>
        </div>

        <nav class="account-nav">
          <a class="account-nav-link active" href="/users/pI" data-page="personal">
            <i class="fas fa-user"></i>
            Personal Information
          </a>

          <a class="account-nav-link" href="/users/order" data-page="orders">
            <i class="fas fa-box"></i>
            My Orders
          </a>

          <a class="account-nav-link" href="/users/wishlist" data-page="wishlist">
            <i class="fas fa-heart"></i>
            My Wishlist
          </a>

          <a class="account-nav-link" href="/users/adr" data-page="addresses">
            <i class="fas fa-location-dot"></i>
            Manage Addresses
          </a>

          <a class="account-nav-link" href="/users/wallet" data-page="wallet">
            <i class="fas fa-wallet"></i>
            Wallet
          </a>

          <form action="/users/logout" method="POST">
            <button type="submit" class="account-nav-link logout-btn" id="logoutBtn">
              <i class="fas fa-right-from-bracket"></i>
              Log Out
            </button>
          </form>
        </nav>
      </aside>

      <section class="content-area">
        <div class="page active" id="personal">
          <div class="page-header">
            <div>
              <p class="card-eyebrow">Profile Details</p>
              <h2>Personal Information</h2>
            </div>

            <button class="edit-button" type="button">
              <i class="fas fa-pen"></i>
              Edit Profile
            </button>
          </div>

          <form id="profile-form" class="form-grid">
            <div class="form-group">
              <label for="username">Username</label>
              <input
                type="text"
                id="username"
                name="username"
                value="<%= safeUser.username || '' %>"
                readonly
              />
              <p class="field-message" id="usernameMessage"></p>
            </div>

            <div class="form-group">
              <label for="email">Email</label>
              <input
                type="email"
                id="email"
                name="email"
                value="<%= safeUser.email || '' %>"
                readonly
              />
            </div>

            <div class="form-group">
              <label for="phone">Phone</label>
              <input
                type="text"
                id="phone"
                name="phone"
                value="<%= safeUser.phone || '' %>"
                readonly
              />
            </div>
          </form>

          <div class="info-grid">
            <div class="info-card">
              <span class="info-icon">
                <i class="fas fa-shield-halved"></i>
              </span>
              <h3>Secure Account</h3>
              <p>Your profile details are protected and only editable where allowed.</p>
            </div>

            <div class="info-card">
              <span class="info-icon">
                <i class="fas fa-face-smile"></i>
              </span>
              <h3>Profile Avatar</h3>
              <p>Choose from ARNI’s pre-created avatars. No image upload needed.</p>
            </div>
          </div>
        </div>
      </section>
    </section>
  </main>

  <div class="avatar-modal" id="avatarModal" aria-hidden="true">
    <div class="avatar-modal-content">
      <button type="button" class="modal-close" id="avatarCancelButton" aria-label="Close avatar picker">
        <i class="fas fa-times"></i>
      </button>

      <p class="card-eyebrow">Choose Avatar</p>
      <h2>Select Your ARNI Avatar</h2>
      <p class="avatar-modal-subtitle">
        Pick one avatar for your profile. You can change it anytime.
      </p>

      <div class="avatar-grid">
        <% avatarOptions.forEach(function(avatarUrl, index) { %>
          <button
            type="button"
            class="avatar-option <%= avatarUrl === profileImage ? 'selected' : '' %>"
            data-avatar-url="<%= avatarUrl %>"
            aria-label="Select avatar <%= index + 1 %>"
          >
            <img src="<%= avatarUrl %>" alt="Avatar <%= index + 1 %>" />
          </button>
        <% }); %>
      </div>

      <div class="modal-actions">
        <button type="button" class="btn-primary" id="saveAvatarButton">
          Save Avatar
        </button>

        <button type="button" class="btn-outline" id="cancelAvatarButton">
          Cancel
        </button>
      </div>
    </div>
  </div>

  <footer class="footer">
    <div class="footer-content">
      <div class="footer-section footer-brand">
        <h3>ARNI</h3>
        <p>Fashion for everyone. Curated with intention.</p>
      </div>

      <div class="footer-section">
        <h3>Quick Links</h3>
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/users/cart">Cart</a>
      </div>

      <div class="footer-section">
        <h3>Contact Us</h3>
        <p>Email: info@arni.com</p>
      </div>

      <div class="footer-section">
        <h3>Follow Us</h3>
        <div class="social-links">
          <a href="mailto:info@arni.com">Email ARNI</a>
        </div>
      </div>
    </div>
  </footer>

  <script id="arni-categories-data" type="application/json">
    <%- JSON.stringify(safeCategories || []) %>
  </script>

  <script src="/javascripts/user/personalInformation.js"></script>
</body>
</html>
