<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>ARNI - Profile Pages</title>
    <link rel="stylesheet" href="/stylesheets/user/profile.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link rel="stylesheet" href="/stylesheets/responsive.css">
</head>
<body>
    <canvas id="backgroundCanvas"></canvas>
    
    <!-- Navbar -->
    <nav class="navbar">
        <div class="nav-container">
            <a href="/" class="logo">ARNI</a>
            <div class="nav-links">
                <a href="/">Home</a>
                <a href="/shop">Shop</a>
                <% categoriesWithSubs.forEach(function(category) { %>
                    <a href="/subcategories?main=<%= category._id %>" 
                       data-category="true"
                       data-categories="<%= JSON.stringify(categoriesWithSubs) %>">
                        <%= category.mainCategoryName.split(' ')
                            .map((word, index) => index === 0 ? 
                                word.charAt(0).toUpperCase() + word.slice(1).toLowerCase() : 
                                word.toLowerCase())
                            .join(' ') %>
                    </a>
                <% }); %>
            </div>
            <div class="nav-right">
                <a href="/users/pI">
                    <i class="fas fa-user-circle"></i> Profile
                </a>
                <a href="/users/cart">🛒</a>
            </div>
        </div>
    </nav>

    <div class="container">
        <div class="main-content">
            <div class="sidebar">
                <div class="profile-header">
                    <div class="profile-image-container">
                        <img src="<%= user.profileImage %>" alt="<%= user.username %> profile avatar">
                    </div>
                    <div>
                        <p style="color: #eab308; font-size: 0.875rem;">Hello,</p>
                        <p style="font-weight: bold; color: #fff;"><%= user.username %></p>
                    </div>
                </div>
                
                <div class="nav-buttons">
                    <a class="nav-button active" href="/users/pI" data-page="personal">👤 Personal Information</a>
                    <a class="nav-button" href="/users/order" data-page="orders">📦 My Orders</a>
                    <a class="nav-button" href="/users/wishlist" data-page="wishlist">♥ My Wishlists</a>
                    <a class="nav-button" href="/users/adr" data-page="addresses">📍 Manage Addresses</a>
                    <a class="nav-button" href="/users/wallet" data-page="wallet">💰 Wallet</a>
                    <form action="/users/logout" method="POST">
                        <button type="submit" class="nav-button" id="logoutBtn">🚪 Log Out</button>
                    </form>
                </div>
            </div>

            <div class="content-area">
                <div class="page active" id="personal">
                    <div class="page-header">
                        <h2>Personal Information</h2>
                        <button type="button" class="edit-button">✏️ Edit Profile</button>
                    </div>
                  
                    <form id="profile-form" class="form-grid">
                        <div class="form-group">
                            <label for="profileUsername">Username</label>
                            <input type="text" id="profileUsername" name="username" value="<%= user.username %>" readonly>
                        </div>
                        <div class="form-group">
                            <label for="profileEmail">Email</label>
                            <input type="email" id="profileEmail" name="email" value="<%= user.email %>" readonly>
                        </div>
                        <div class="form-group">
                            <label for="profilePhone">Phone</label>
                            <input type="text" id="profilePhone" name="phone" value="<%= user.phone %>" readonly>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div class="footer-content">
            <div class="footer-section">
                <h3>About ARNI</h3>
                <p>Fashion for everyone</p>
            </div>
            <div class="footer-section">
                <h3>Quick Links</h3>
                <a href="/">Home</a>
            <a href="/shop">Shop</a>
            </div>
            <div class="footer-section">
                <h3>Contact Us</h3>
                <p>Email: info@arni.com</p>
            </div>
            <div class="footer-section">
                <h3>Follow Us</h3>
                <div class="social-links">
                    <a href="#">Instagram</a>
                    <a href="#">Facebook</a>
                    <a href="#">Twitter</a>
                </div>
            </div>
        </div>
    </footer>



    <script src="/javascripts/user/personalInformation.js"></script>
    <script src="/javascripts/responsive.js"></script>
</body>
</html>
