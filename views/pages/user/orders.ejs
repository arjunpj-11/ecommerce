<%
  const safeCategories = typeof categoriesWithSubs !== 'undefined' && Array.isArray(categoriesWithSubs)
    ? categoriesWithSubs
    : [];

  const safeOrders = typeof orders !== 'undefined' && Array.isArray(orders)
    ? orders
    : [];

  const safeUser = typeof user !== 'undefined' && user
    ? user
    : {};

  const safePagination = typeof pagination !== 'undefined' && pagination
    ? pagination
    : {
        currentPage: 1,
        totalPages: 1
      };

  const profileImage =
    safeUser.profileImage ||
    safeUser.avatarUrl ||
    safeUser.image ||
    '/images/avatars/avatar-1.svg';

  function getPageNumbers(current, total) {
    let pages = [];

    if (!total || total < 1) {
      return [{ number: 1 }];
    }

    if (total <= 7) {
      for (let i = 1; i <= total; i++) {
        pages.push({ number: i });
      }
    } else {
      pages.push({ number: 1 });

      if (current > 3) {
        pages.push({ ellipsis: true });
      }

      for (
        let i = Math.max(2, current - 1);
        i <= Math.min(current + 1, total - 1);
        i++
      ) {
        pages.push({ number: i });
      }

      if (current < total - 2) {
        pages.push({ ellipsis: true });
      }

      pages.push({ number: total });
    }

    return pages;
  }

  const pages = getPageNumbers(
    safePagination.currentPage || 1,
    safePagination.totalPages || 1
  );
%>

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>My Orders - ARNI</title>

  <link rel="stylesheet" href="/stylesheets/user/profile.css" />
  <link rel="stylesheet" href="/stylesheets/style.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
</head>

<body>
  <canvas id="backgroundCanvas"></canvas>

  <header class="navbar" id="navbar">
    <div class="nav-inner">
      <a href="/" class="logo">ARNI</a>

      <nav class="nav-links" id="navLinks">
        <a href="/" class="nav-link">Home</a>
        <a href="/shop" class="nav-link">Shop</a>

        <% if (safeCategories.length > 0) { %>
          <a href="/shop" class="nav-link has-dropdown" data-category="true">
            Categories
            <i class="fas fa-chevron-down dropdown-arrow"></i>
          </a>
        <% } %>
      </nav>

      <div class="nav-actions">
        <button class="icon-btn search-toggle" type="button" aria-label="Search">
          <i class="fas fa-search"></i>
        </button>

        <a href="/users/cart" class="icon-btn" aria-label="Cart">
          <i class="fas fa-shopping-bag"></i>
        </a>

        <a href="/users/pI" class="icon-btn profile-btn active" aria-label="Profile">
          <i class="fas fa-user"></i>
        </a>

        <button class="hamburger" id="hamburger" type="button" aria-label="Menu">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </div>

    <div class="search-overlay" id="searchOverlay">
      <form class="search-form" action="/search" method="GET">
        <input
          type="text"
          name="search"
          placeholder="Search for products, styles, brands..."
          class="search-input"
        />

        <button type="submit" class="search-submit" aria-label="Submit search">
          <i class="fas fa-search"></i>
        </button>

        <button type="button" class="search-close" id="searchClose" aria-label="Close search">
          <i class="fas fa-times"></i>
        </button>
      </form>
    </div>
  </header>

  <div class="mobile-overlay" id="mobileOverlay"></div>

  <aside class="mobile-drawer" id="mobileDrawer">
    <button class="drawer-close" id="drawerClose" type="button" aria-label="Close menu">
      <i class="fas fa-times"></i>
    </button>

    <div class="drawer-logo">ARNI</div>

    <nav class="drawer-nav">
      <a href="/">Home</a>
      <a href="/shop">Shop</a>
      <a href="/users/cart">Cart</a>
      <a href="/users/pI">Profile</a>

      <% safeCategories.forEach(function(category) { %>
        <a href="/subcategories?main=<%= category._id %>">
          <%= category.mainCategoryName %>
        </a>
      <% }); %>
    </nav>
  </aside>

  <main class="profile-page">
    <section class="profile-hero reveal">
      <p class="section-eyebrow">My Account</p>
      <h1>My Orders</h1>
      <p>Track your purchases, check delivery status, and open order details from one clean dashboard.</p>
    </section>

    <section class="profile-layout">
      <aside class="sidebar reveal">
        <div class="profile-card">
          <div class="profile-image-container">
            <img
              src="<%= profileImage %>"
              alt="<%= safeUser.username || 'User' %>"
              class="profile-image"
            />
          </div>

          <p class="hello-text">Hello,</p>
          <h2><%= safeUser.username || 'ARNI User' %></h2>
          <p class="profile-subtitle">Review your latest orders and delivery updates.</p>
        </div>

        <nav class="account-nav">
          <a class="account-nav-link" href="/users/pI" data-page="personal">
            <i class="fas fa-user"></i>
            Personal Information
          </a>

          <a class="account-nav-link active" href="/users/order" data-page="orders">
            <i class="fas fa-box"></i>
            My Orders
          </a>

          <a class="account-nav-link" href="/users/wishlist" data-page="wishlist">
            <i class="fas fa-heart"></i>
            My Wishlist
          </a>

          <a class="account-nav-link" href="/users/adr" data-page="addresses">
            <i class="fas fa-location-dot"></i>
            Manage Addresses
          </a>

          <a class="account-nav-link" href="/users/wallet" data-page="wallet">
            <i class="fas fa-wallet"></i>
            Wallet
          </a>

          <form action="/users/logout" method="POST">
            <button type="submit" class="account-nav-link logout-btn" id="logoutBtn">
              <i class="fas fa-right-from-bracket"></i>
              Log Out
            </button>
          </form>
        </nav>
      </aside>

      <section class="content-area reveal">
        <div class="page active" id="orders">
          <div class="page-header">
            <div>
              <p class="card-eyebrow">Order History</p>
              <h2>Your Orders</h2>
            </div>

            <a href="/shop" class="edit-button">
              <i class="fas fa-bag-shopping"></i>
              Continue Shopping
            </a>
          </div>

          <% if (safeOrders.length === 0) { %>
            <div class="empty-address-state empty-orders-state">
              <div class="empty-icon">
                <i class="fas fa-box-open"></i>
              </div>

              <h3>No orders yet</h3>
              <p>Your purchased products will appear here once you place an order.</p>

              <a href="/shop" class="btn-primary empty-order-action">
                Start Shopping
              </a>
            </div>
          <% } else { %>
            <div class="orders-list" id="ordersList">
              <% safeOrders.forEach((order) => { 
                const orderTotal = Number(order.price || 0) * Number(order.quantity || 1);
                const orderStatus = order.status || 'Processing';
                const statusClass = String(orderStatus).toLowerCase().replace(/\s+/g, '-');
              %>
                <article class="order-card" data-order-id="<%= order._id %>">
                  <div class="order-product">
                    <div class="order-image-wrap">
                      <img
                        src="<%= order.image %>"
                        alt="<%= order.name || 'Product' %>"
                        class="order-image"
                      />
                    </div>

                    <div class="order-product-info">
                      <p class="order-label">Product</p>
                      <h3><%= order.name || 'Product Name' %></h3>

                      <% if (order.quantity) { %>
                        <p class="order-meta">
                          Quantity: <strong><%= order.quantity %></strong>
                        </p>
                      <% } %>
                    </div>
                  </div>

                  <div class="order-summary">
                    <div class="order-summary-item">
                      <p class="order-label">Total</p>
                      <h4>₹<%= orderTotal.toFixed(2) %></h4>
                    </div>

                    <div class="order-summary-item">
                      <p class="order-label">Status</p>
                      <span class="order-status status-<%= statusClass %>">
                        <%= orderStatus %>
                      </span>
                    </div>
                  </div>

                  <div class="order-actions">
                    <% if (order.status !== 'Cancelled' && order.status !== 'Returned') { %>
                      <button class="lets-go-button" type="button" data-order-id="<%= order._id %>">
                        View Details
                        <i class="fas fa-arrow-right"></i>
                      </button>
                    <% } else { %>
                      <button class="lets-go-button disabled" type="button" disabled>
                        Unavailable
                      </button>
                    <% } %>
                  </div>
                </article>
              <% }); %>
            </div>

            <div class="pagination-container">
              <div class="pagination-controls">
                <a
                  href="?page=<%= Math.max(1, safePagination.currentPage - 1) %>"
                  class="pagination-button <%= safePagination.currentPage === 1 ? 'disabled' : '' %>"
                  aria-disabled="<%= safePagination.currentPage === 1 ? 'true' : 'false' %>"
                >
                  <i class="fas fa-arrow-left"></i>
                </a>

                <% pages.forEach(page => { %>
                  <% if (page.ellipsis) { %>
                    <span class="pagination-ellipsis">...</span>
                  <% } else { %>
                    <a
                      href="?page=<%= page.number %>"
                      class="pagination-button <%= safePagination.currentPage === page.number ? 'active' : '' %>"
                    >
                      <%= page.number %>
                    </a>
                  <% } %>
                <% }); %>

                <a
                  href="?page=<%= Math.min(safePagination.totalPages, safePagination.currentPage + 1) %>"
                  class="pagination-button <%= safePagination.currentPage === safePagination.totalPages ? 'disabled' : '' %>"
                  aria-disabled="<%= safePagination.currentPage === safePagination.totalPages ? 'true' : 'false' %>"
                >
                  <i class="fas fa-arrow-right"></i>
                </a>
              </div>

              <div class="pagination-info">
                Page <%= safePagination.currentPage %> of <%= safePagination.totalPages %>
              </div>
            </div>
          <% } %>
        </div>
      </section>
    </section>
  </main>

  <footer class="footer">
    <div class="footer-content">
      <div class="footer-section footer-brand">
        <h3>ARNI</h3>
        <p>Fashion for everyone. Curated with intention.</p>
      </div>

      <div class="footer-section">
        <h3>Quick Links</h3>
        <a href="/">Home</a>
        <a href="/shop">Shop</a>
        <a href="/users/cart">Cart</a>
      </div>

      <div class="footer-section">
        <h3>Contact Us</h3>
        <p>Email: info@arni.com</p>
      </div>

      <div class="footer-section">
        <h3>Follow Us</h3>
        <div class="social-links">
          <a href="mailto:info@arni.com">Email ARNI</a>
        </div>
      </div>
    </div>
  </footer>

  <script id="arni-categories-data" type="application/json">
    <%- JSON.stringify(safeCategories || []) %>
  </script>

  <script src="/javascripts/user/orders.js"></script>
</body>
</html>
